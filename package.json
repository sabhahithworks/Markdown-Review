{
  "name": "markdown-review",
  "displayName": "Markdown Review",
  "version": "0.1.0",
  "description": "Comment on markdown documents and hand your review to any AI agent.",
  "publisher": "sabhahithworks",
  "author": "Nagaraja Sabhahith",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sabhahithworks/Markdown-Review"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "review",
    "comments",
    "ai",
    "agent"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownReview.open",
        "title": "Markdown Review: Open Review Pane",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "markdownReview.copyPrompt",
        "title": "Markdown Review: Copy Review Prompt"
      },
      {
        "command": "markdownReview.clearAddressed",
        "title": "Markdown Review: Clear Addressed Comments"
      },
      {
        "command": "markdownReview.clearAll",
        "title": "Markdown Review: Clear All Comments"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownReview.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownReview.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Review",
      "properties": {
        "markdownReview.author": {
          "type": "string",
          "default": "",
          "description": "Name attached to your comments. Defaults to your system username."
        },
        "markdownReview.storageLocation": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "workspace",
          "markdownDescription": "`workspace` writes to `.reviews/` (shareable via git). `global` keeps comments private to your machine."
        },
        "markdownReview.autoDetectResolution": {
          "type": "boolean",
          "default": true,
          "description": "Mark comments as addressed when their anchored text changes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "package": "npx --yes @vscode/vsce package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.mjs --integration && node dist-test/run.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.webview-test.json --noEmit",
    "lint": "eslint .",
    "lint:css": "node scripts/check-css-colors.mjs && node scripts/check-theme-vars.mjs",
    "lint:bundles": "node scripts/check-bundles.mjs",
    "build": "node esbuild.mjs && npm run lint:css && npm run lint:bundles",
    "watch": "node esbuild.mjs --watch",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
